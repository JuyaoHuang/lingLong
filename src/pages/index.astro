<style>
  .avatar-rotate {
    transition: transform 0.5s ease-out;
  }
  .homepage-bg {
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1.0) 0%, transparent 100%);
  }
  .homepage-bg-dark {
    display: none;
  }
  :global(.dark) .homepage-bg-light {
    display: none;
  }
  :global(.dark) .homepage-bg-dark {
    display: block;
  }
</style>

<script>
  const avatar = document.querySelector('.avatar-rotate') as HTMLElement
  if (avatar) {
    let rotation = 0
    let speed = 0
    let animationId: number | null = null
    const maxSpeed = 99999
    // const acceleration = 0.003

    const animate = () => {
      if (speed >= maxSpeed) {
        rotation = 0
        speed = 0
        avatar.style.transform = 'rotate(0deg)'
        animationId = null
        return
      }

      speed = speed * 1.001 + 0.003
      rotation += speed
      avatar.style.transform = `rotate(${rotation}deg)`
      animationId = requestAnimationFrame(animate)
    }

    avatar.addEventListener('mouseenter', () => {
      if (!animationId) {
        rotation = 0
        speed = 0
        animate()
      }
    })

    avatar.addEventListener('mouseleave', () => {
      if (animationId) {
        cancelAnimationFrame(animationId)
        animationId = null
      }
      rotation = 0
      speed = 0
      avatar.style.transform = 'rotate(0deg)'
    })
  }
</script>
